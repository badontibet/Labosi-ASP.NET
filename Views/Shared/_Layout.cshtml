<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NAS Indexer</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lab4.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="side-rail">
            <a class="brand-lockup" asp-controller="Home" asp-action="Index" aria-label="NAS Indexer dashboard">
                <span class="brand-mark">NI</span>
                <span>
                    <strong>NAS Indexer</strong>
                    <small>Ops console</small>
                </span>
            </a>

            <details class="mobile-nav-shell">
                <summary class="mobile-nav-toggle">Menu</summary>
                <div class="rail-nav-content">
                    <form class="global-search-form" asp-controller="Search" asp-action="Index" method="get">
                        <label for="global-search-nav-input">Global search</label>
                        <div class="global-search-row">
                            <input id="global-search-nav-input"
                                   class="form-control"
                                   type="search"
                                   name="q"
                                   maxlength="@GlobalSearchViewModel.MaxQueryLength"
                                   placeholder="Search NAS index..."
                                   autocomplete="off" />
                            <button type="submit" class="primary-action">Search</button>
                        </div>
                    </form>

                    <nav class="primary-nav" aria-label="Primary navigation">
                        <a asp-controller="Home" asp-action="Index">Dashboard</a>
                        <a asp-controller="NasServers" asp-action="Index">NAS Servers</a>
                        <a asp-controller="ScanJobs" asp-action="Index">Scan Jobs</a>
                        <a asp-controller="Directories" asp-action="Index">Directories</a>
                        <a asp-controller="FileItems" asp-action="Index">Files</a>
                        <a asp-controller="FileChangeLogs" asp-action="Index">Change Logs</a>
                        <a asp-controller="Tags" asp-action="Index">Tags</a>
                        <a asp-controller="Admins" asp-action="Index">Admins</a>
                    </nav>

                    <partial name="_LoginPartial" />

                    <div class="rail-note">
                        <span class="pulse-dot"></span>
                        EF SQLite repository feed
                    </div>
                </div>
            </details>
        </aside>

        <main class="content-deck">
            @RenderBody()
        </main>
    </div>
    <script src="~/js/lab4.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
