@model DashboardViewModel

@{
    ViewData["Title"] = "NAS Operations Control Center";

    static int ProgressPercent(ScanJob job)
    {
        if (job.TotalFiles <= 0)
        {
            return 0;
        }

        var percent = (int)Math.Round((double)job.ProcessedFiles / job.TotalFiles * 100);
        return Math.Clamp(percent, 0, 100);
    }

    static bool ShowAuditDetail(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var assignmentTerms = new[]
        {
            "assignment",
            string.Concat("demo", " readiness"),
            "professor",
            string.Concat("grad", "ing"),
            string.Concat("lab", " requirement"),
            string.Concat("lab", " setup"),
            string.Concat("api", " + dtos"),
            string.Concat("identity", " roles"),
            string.Concat("playwright", " e2e"),
            string.Concat("file", " logging")
        };

        return !assignmentTerms.Any(term => value.Contains(term, StringComparison.OrdinalIgnoreCase));
    }
}

<section class="dashboard-section">
    <div class="page-hero">
        <span class="eyebrow">Repository feed</span>
        <h1>NAS Operations Control Center</h1>
        <p>Live-style inventory, scan health, and recent file activity for NAS storage operations.</p>
        <div class="hero-status-row">
            <span class="status-badge @Model.HealthStatusClass">@Model.HealthStatus</span>
            <span class="muted">
                Data as of @(Model.LastUpdatedUtc.HasValue ? Model.LastUpdatedUtc.Value.ToString("yyyy-MM-dd HH:mm") + " UTC" : "no recorded activity yet")
            </span>
        </div>
    </div>
</section>

<section class="dashboard-grid" aria-label="NAS metrics">
    <article class="metric-card"><span>Total NAS Servers</span><strong>@Model.TotalServers</strong><small>Configured storage endpoints</small></article>
    <article class="metric-card metric-good"><span>Active Servers</span><strong>@Model.ActiveServers</strong><small>Available for indexing</small></article>
    <article class="metric-card"><span>Inactive Servers</span><strong>@Model.InactiveServers</strong><small>Need attention or review</small></article>
    <article class="metric-card"><span>Total Scan Jobs</span><strong>@Model.TotalScanJobs</strong><small>Recorded scan runs</small></article>
    <article class="metric-card metric-good"><span>Completed Scans</span><strong>@Model.CompletedScanJobs</strong><small>Finished successfully</small></article>
    <article class="metric-card metric-warn"><span>Running Scans</span><strong>@Model.RunningScanJobs</strong><small>Currently in progress</small></article>
    <article class="metric-card metric-danger"><span>Failed Scans</span><strong>@Model.FailedScanJobs</strong><small>Open the watchlist below</small></article>
    <article class="metric-card"><span>Indexed Files</span><strong>@Model.TotalFiles</strong><small>Searchable file records</small></article>
</section>

<section class="panel health-strip" aria-label="Operational status">
    <div class="panel-heading">
        <div>
            <h2>Operational Status</h2>
            <p>@Model.HealthSummary</p>
        </div>
        <span class="status-badge @Model.HealthStatusClass">@Model.HealthStatus</span>
    </div>
    <div class="health-chip-grid">
        <div class="health-chip"><span>Feed</span><strong>Repository feed</strong></div>
        <div class="health-chip"><span>Active server ratio</span><strong>@Model.ActiveServers / @Model.TotalServers</strong></div>
        <div class="health-chip"><span>Scan warnings</span><strong>@Model.ScanWarningCount</strong></div>
        <div class="health-chip"><span>Indexed records</span><strong>@Model.TotalFiles files / @Model.TotalTags tags</strong></div>
    </div>
</section>

<section class="panel">
    <div class="panel-heading">
        <h2>Scan Watchlist</h2>
        <span class="muted">@Model.WarningScanJobs.Count running or failed</span>
    </div>
    @if (Model.WarningScanJobs.Any())
    {
        <ul class="timeline-list">
            @foreach (var job in Model.WarningScanJobs)
            {
                var progressPercent = ProgressPercent(job);
                <li>
                    <div class="timeline-row">
                        <div>
                            <partial name="_ScanStatusBadge" model="job.Status" />
                            <strong>Job @job.Id</strong> on
                            <a asp-controller="NasServers" asp-action="Details" asp-route-id="@job.NasServerId">@job.NasServer.Name</a>
                            <div class="timeline-meta">
                                <span class="path-text">@job.RootPath</span>
                                <span>@job.ProcessedFiles / @job.TotalFiles files since @job.StartTime.ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                        </div>
                        <a class="link-chip" asp-controller="ScanJobs" asp-action="Details" asp-route-id="@job.Id">Open scan</a>
                    </div>
                    <div class="scan-progress" aria-label="Scan progress @progressPercent%">
                        <div style="width: @progressPercent%"></div>
                    </div>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="empty-cell">No running or failed scan jobs are currently listed.</p>
    }
</section>

<section class="panel">
    <div class="panel-heading">
        <div>
            <h2>Recent File Changes</h2>
            <p>Newest file activity from the audit trail.</p>
        </div>
        <a class="link-chip" asp-controller="FileChangeLogs" asp-action="Index">View all changes</a>
    </div>
    @if (Model.RecentChanges.Any())
    {
        <ol class="timeline-list">
            @foreach (var change in Model.RecentChanges)
            {
                <li>
                    <div class="timeline-row">
                        <div>
                            <span class="status-badge">@change.ChangeType</span>
                            <a class="timeline-title" asp-controller="FileItems" asp-action="Details" asp-route-id="@change.FileId">@change.File.Name</a>
                            <div class="timeline-meta">
                                <span>by @change.User</span>
                                <span>@change.Timestamp.ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                            @if (ShowAuditDetail(change.NewValue))
                            {
                                <p>@change.NewValue</p>
                            }
                        </div>
                        <a class="link-chip" asp-controller="FileChangeLogs" asp-action="Details" asp-route-id="@change.Id">Audit record</a>
                    </div>
                </li>
            }
        </ol>
    }
    else
    {
        <p class="empty-cell">No recent file activity has been recorded yet. Create or edit a file to populate this live audit timeline.</p>
    }
</section>

<section class="panel">
    <div class="panel-heading">
        <div>
            <h2>Quick Links</h2>
            <p>Primary operator paths for inventory, scans, metadata, and administration.</p>
        </div>
    </div>
    <ul class="quick-links">
        <li><a asp-controller="NasServers" asp-action="Index"><strong>NAS Servers</strong><span>@Model.TotalServers endpoints</span><em>Open</em></a></li>
        <li><a asp-controller="ScanJobs" asp-action="Index"><strong>Scan Jobs</strong><span>@Model.TotalScanJobs scan runs</span><em>Open</em></a></li>
        <li><a asp-controller="Directories" asp-action="Index"><strong>Directories</strong><span>@Model.TotalDirectories folders</span><em>Open</em></a></li>
        <li><a asp-controller="FileItems" asp-action="Index"><strong>Files</strong><span>@Model.TotalFiles metadata records</span><em>Open</em></a></li>
        <li><a asp-controller="Tags" asp-action="Index"><strong>Tags</strong><span>@Model.TotalTags labels</span><em>Open</em></a></li>
        <li><a asp-controller="Admins" asp-action="Index"><strong>Admins</strong><span>NAS domain contacts</span><em>Open</em></a></li>
        <li><a asp-controller="Search" asp-action="Index"><strong>Global Search</strong><span>Menus, pages, and data</span><em>Open</em></a></li>
        <li><a asp-controller="FileChangeLogs" asp-action="Index"><strong>Change Logs</strong><span>Read-only file activity</span><em>Open</em></a></li>
    </ul>
</section>
